# Chat assistant proxy (/api/assistant/chat). Server-side only — never exposed to the browser.
# Required for the assistant to work; without it the proxy returns 501 and the UI degrades gracefully.
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to the "opus" tier (claude-opus-5-5).
# Set a full model id to pin it, e.g. claude-sonnet-5-5 or claude-haiku-5-5.
# ASSISTANT_MODEL=

# Backend (Python FastAPI) origin for the dev API proxy. Read at BUILD time and
# baked into the Next rewrite, so set it when building if you rely on the proxy.
# In production the dashboard usually sits behind a reverse proxy that routes
# /api/v1 to the backend, and this is unused.
API_ORIGIN=http://localhost:8000

# Where the browser calls the backend. Default "/api/v1" = same-origin (uses the
# proxy / reverse proxy, no CORS). Set a full origin (e.g. https://api.example.com)
# to call a remote backend directly — that path needs CORS on the backend.
# Inlined at BUILD time (NEXT_PUBLIC_*).
# NEXT_PUBLIC_API_BASE_URL=/api/v1
